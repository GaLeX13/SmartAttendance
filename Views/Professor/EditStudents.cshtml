@{
    ViewData["Title"] = "Adaugă studenți";
}

<div class="app-shell">
    <div class="hero-card dashboard-card">

        <h2>Adaugă studenți</h2>
        <div class="muted">
            Materie: <strong>@ViewBag.CourseName</strong>
        </div>

        <form method="post">
            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />

            <label class="lbl" style="margin-top:16px;">
                Emailuri studenți (un email pe linie)
            </label>

            <textarea name="studentEmails"
                      class="form-control"
                      rows="10"
                      placeholder="student1@email.com
student2@email.com
student3@email.com"></textarea>

            <div class="add-actions" style="margin-top:20px;">
                <button type="submit" class="btn-primary-soft">
                    Salvează
                </button>

                <a href="@Url.Action("Index", "Professor")"
                   class="btn-ghost">
                    Renunță
                </a>
            </div>
        </form>

    </div>
</div>
