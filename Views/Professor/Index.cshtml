@model List<SmartAttendance.Models.Course>

@{
    ViewData["Title"] = "Professor Dashboard";
    var courses = Model ?? new List<SmartAttendance.Models.Course>();
    var hasCourses = courses.Count > 0;
}

<div class="app-shell">
    <div class="hero-card dashboard-card">

        <div class="brand">Smart Attendance</div>

        <div class="hero-title" style="font-size:40px; margin-top:16px;">
            Professor <span style="color:#2f7dbf;">Dashboard</span>
        </div>

        <div style="margin-top:6px;">
            Welcome, @(ViewBag.ProfessorDisplayName ?? "Professor")
        </div>

        <div class="dash-top">
            <div class="dash-left">
                @if (!hasCourses)
                {
                    <div class="muted" style="margin-top:14px; max-width:420px;">
                        You do not have any courses or laboratories yet.<br />
                        Create one to get started.
                    </div>
                }
            </div>

            <div class="dash-right">
                <button id="btnShowAdd" class="btn-primary-soft" type="button">
                    + Add Course
                </button>
            </div>
        </div>

        <div id="addPanel" class="add-panel hidden">
            <form method="post" action="@Url.Action("AddCourse", "Professor")" class="add-form">
                <div class="add-grid">
                    <div>
                        <label class="lbl">Course Name</label>
                        <input class="form-control" name="name" placeholder="Example: Operating Systems" />
                    </div>

                    <div>
                        <label class="lbl">Type</label>
                        <select class="form-control" name="type">
                            <option value="course">Course</option>
                            <option value="lab">Laboratory</option>
                        </select>
                    </div>
                </div>

                <div class="add-actions">
                    <button class="btn-primary-soft" type="submit" style="width:220px;">Save</button>
                    <button id="btnCancelAdd" class="btn-ghost" type="button">Cancel</button>
                </div>
            </form>
        </div>

        <div class="courses-wrap">
            @if (hasCourses)
            {
                <div class="courses-scroll">
                    @foreach (var c in courses)
                    {
                        <div class="course-card">
                            <div class="course-main">
                                <div class="course-title">@c.Name</div>
                                <div class="course-sub">
                                    @(c.IsLab ? "Laboratory" : "Course")
                                </div>
                            </div>

                            <div class="course-stat">
                                <div class="stat-label">Students</div>
                                <div class="stat-val">@c.StudentCount</div>
                            </div>

                            <div class="course-stat">
                                <div class="stat-label">Attendance</div>
                                <div class="stat-val">@c.AttendancePercent%</div>
                            </div>

                            <div class="course-actions action-buttons">
                                <a class="btn-secondary-soft"
                                   href="@Url.Action("Course", "Professor", new { id = c.Id })">
                                    View
                                </a>

                                <a class="btn-secondary-soft"
                                   href="@Url.Action("AddStudents", "Professor", new { courseId = c.Id })">
                                    Add students
                                </a>

                                <form method="post" action="@Url.Action("DeleteCourse", "Professor")" style="display:inline;">
                                    <input type="hidden" name="id" value="@c.Id" />

                                    <button class="btn-danger-soft"
                                            type="submit"
                                            onclick="return confirm('Delete this course?');">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="courses-empty">Your courses will appear here.</div>
            }
        </div>

    </div>
</div>

<script>
    const panel = document.getElementById("addPanel");
    const showBtn = document.getElementById("btnShowAdd");
    const cancelBtn = document.getElementById("btnCancelAdd");

    showBtn.addEventListener("click", () => panel.classList.toggle("hidden"));
    cancelBtn.addEventListener("click", () => panel.classList.add("hidden"));
</script>