@model SmartAttendance.Models.Course
@using System.Globalization
@using System.Collections.Generic
@using SmartAttendance.Models

@{
    ViewData["Title"] = Model.Name;

    int presentCount = ViewBag.PresentCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
    int recoveredCount = ViewBag.RecoveredCount ?? 0;
    int attendancePercent = ViewBag.AttendancePercent ?? 0;

    var attendanceRecords = ViewBag.AttendanceRecords as IEnumerable<AttendanceRecord>
        ?? Enumerable.Empty<AttendanceRecord>();

    var graphRecords = attendanceRecords
        .Where(r => r.Status == "Present" || r.Status == "Absent" || r.Status == "Recovered")
        .ToList();

    var today = DateTime.Today;
    var currentWeekStart = today.AddDays(-(((int)today.DayOfWeek + 6) % 7)).Date;

    var selectedWeekText = Context.Request.Query["weekStart"].ToString();
    var selectedWeekStart = currentWeekStart;

    if (DateTime.TryParse(selectedWeekText, out var parsedWeek))
    {
        selectedWeekStart = parsedWeek.Date.AddDays(-(((int)parsedWeek.DayOfWeek + 6) % 7)).Date;
    }

    var selectedWeekEnd = selectedWeekStart.AddDays(6);

    var weekRecords = graphRecords
        .Where(r => r.Date.Date >= selectedWeekStart && r.Date.Date <= selectedWeekEnd)
        .ToList();

    int weekPresent = weekRecords.Count(r => r.Status == "Present");
    int weekRecovered = weekRecords.Count(r => r.Status == "Recovered");
    int weekAbsent = weekRecords.Count(r => r.Status == "Absent");
    int totalWeekRecords = weekPresent + weekRecovered + weekAbsent;

    var availableWeeks = graphRecords
        .Select(r => r.Date.Date.AddDays(-(((int)r.Date.DayOfWeek + 6) % 7)))
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    DateTime? previousWeek = availableWeeks
        .Where(d => d < selectedWeekStart)
        .Select(d => (DateTime?)d)
        .LastOrDefault();

    DateTime? nextWeek = availableWeeks
        .Where(d => d > selectedWeekStart)
        .Select(d => (DateTime?)d)
        .FirstOrDefault();

    if (selectedWeekStart < currentWeekStart && (!nextWeek.HasValue || nextWeek.Value > currentWeekStart))
    {
        nextWeek = currentWeekStart;
    }

    var selectedWeekLabel = $"Week {ISOWeek.GetWeekOfYear(selectedWeekStart)}, {ISOWeek.GetYear(selectedWeekStart)}";

    double presentAngle = totalWeekRecords > 0 ? weekPresent * 360.0 / totalWeekRecords : 0;
    double recoveredAngle = totalWeekRecords > 0 ? weekRecovered * 360.0 / totalWeekRecords : 0;

    var presentEnd = presentAngle;
    var recoveredEnd = presentAngle + recoveredAngle;

    var presentEndText = presentEnd.ToString("0.##", CultureInfo.InvariantCulture);
    var recoveredEndText = recoveredEnd.ToString("0.##", CultureInfo.InvariantCulture);

    string pieBackground = totalWeekRecords > 0
        ? $"conic-gradient(#188a3a 0deg {presentEndText}deg, #2288c8 {presentEndText}deg {recoveredEndText}deg, #b00020 {recoveredEndText}deg 360deg)"
        : "#d9e4ef";
}

<div class="app-shell">
    <div class="hero-card course-view-card">

        <div class="course-view-header course-header">
            <div>
                <div class="brand">Smart Attendance</div>

                <div class="hero-title" style="font-size:34px; margin-top:16px;">
                    @Model.Name
                </div>

                <div class="muted">
                    @(Model.IsLab ? "Laboratory" : "Course")
                </div>
            </div>

            <div class="course-header-actions">
                <a href="@Url.Action("Index", "Rfid", new { courseId = Model.Id })"
                   class="btn-primary-soft course-nav-btn">
                    RFID Tags
                </a>

                <a href="@Url.Action("Index", "Hardware", new { courseId = Model.Id })"
                   class="btn-primary-soft course-nav-btn">
                    Hardware Control
                </a>

                <a href="@Url.Action("CourseSettings", "Professor", new { id = Model.Id })"
                   class="btn-primary-soft course-nav-btn">
                    Class Settings
                </a>

                <a href="@Url.Action("ClassReport", "Professor", new { courseId = Model.Id })"
                   class="btn-primary-soft course-nav-btn">
                    Class Report
                </a>

                <a href="@Url.Action("Index", "Professor")"
                   class="course-back-link">
                    Back to dashboard
                </a>
            </div>
        </div>

        <div class="course-view-grid">

            <div class="course-info-card">
                <h2>Statistics</h2>

                <div class="stat-box-grid">
                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Students</div>
                        <div class="stat-mini-value">@Model.CourseStudents.Count</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Average attendance</div>
                        <div class="stat-mini-value">@attendancePercent%</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Present</div>
                        <div class="stat-mini-value">@presentCount</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Absences</div>
                        <div class="stat-mini-value">@absentCount</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Recoveries</div>
                        <div class="stat-mini-value">@recoveredCount</div>
                    </div>
                </div>

                <div class="week-pie-card">
                    <div class="week-pie-header">
                        <div>
                            <h3>Attendance progress by week</h3>
                        </div>

                        <div class="week-pie-period">
                            <div class="week-pie-title">@selectedWeekLabel</div>
                            <div class="week-pie-dates">
                                @selectedWeekStart.ToString("dd.MM.yyyy") - @selectedWeekEnd.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    </div>

                    @if (!graphRecords.Any())
                    {
                        <div class="week-empty-state">
                            No attendance records have been added yet.
                        </div>
                    }
                    else if (totalWeekRecords == 0)
                    {
                        <div class="week-pie-nav-only">
                            @if (previousWeek.HasValue)
                            {
                                <a class="week-nav-btn"
                                   href="@Url.Action("Course", "Professor", new { id = Model.Id, weekStart = previousWeek.Value.ToString("yyyy-MM-dd") })">
                                    &lt;
                                </a>
                            }
                            else
                            {
                                <span class="week-nav-btn disabled">&lt;</span>
                            }

                            <div class="week-empty-state">
                                No graph for this week.
                            </div>

                            @if (nextWeek.HasValue)
                            {
                                <a class="week-nav-btn"
                                   href="@Url.Action("Course", "Professor", new { id = Model.Id, weekStart = nextWeek.Value.ToString("yyyy-MM-dd") })">
                                    &gt;
                                </a>
                            }
                            else
                            {
                                <span class="week-nav-btn disabled">&gt;</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="week-pie-body">
                            @if (previousWeek.HasValue)
                            {
                                <a class="week-nav-btn"
                                   href="@Url.Action("Course", "Professor", new { id = Model.Id, weekStart = previousWeek.Value.ToString("yyyy-MM-dd") })">
                                    &lt;
                                </a>
                            }
                            else
                            {
                                <span class="week-nav-btn disabled">&lt;</span>
                            }

                            <div class="week-pie-visual-wrap">
                                <div class="week-pie-visual" style="background:@pieBackground;"></div>
                            </div>

                            @if (nextWeek.HasValue)
                            {
                                <a class="week-nav-btn"
                                   href="@Url.Action("Course", "Professor", new { id = Model.Id, weekStart = nextWeek.Value.ToString("yyyy-MM-dd") })">
                                    &gt;
                                </a>
                            }
                            else
                            {
                                <span class="week-nav-btn disabled">&gt;</span>
                            }
                        </div>

                        <div class="week-pie-summary">
                            <div class="week-pie-row">
                                <span class="dot present"></span>
                                <span class="label">Present</span>
                                <span class="value">@weekPresent</span>
                            </div>

                            <div class="week-pie-row">
                                <span class="dot recovered"></span>
                                <span class="label">Recovered</span>
                                <span class="value">@weekRecovered</span>
                            </div>

                            <div class="week-pie-row">
                                <span class="dot absent"></span>
                                <span class="label">Absent</span>
                                <span class="value">@weekAbsent</span>
                            </div>

                            <div class="week-pie-total">
                                Total records: @totalWeekRecords
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="course-students-card">
                <div class="students-header">
                    <h2>Enrolled Students</h2>
                    <span class="plain-student-count">@Model.CourseStudents.Count</span>
                </div>

                <div class="students-search-wrap">
                    <input id="studentSearch"
                           class="students-search-input"
                           type="text"
                           placeholder="Search student by email..." />
                </div>

                <div class="students-scroll">
                    @if (!Model.CourseStudents.Any())
                    {
                        <div class="muted">No students are enrolled yet.</div>
                    }
                    else
                    {
                        @foreach (var cs in Model.CourseStudents)
                        {
                            <div class="student-row" data-student-email="@cs.Student.Email.ToLower()">
                                <div class="student-email">
                                    @cs.Student.Email
                                </div>

                                <div class="student-actions">
                                    <a class="btn-secondary-soft student-action-btn"
                                       href="@Url.Action("StudentAttendance", "Professor", new { courseId = Model.Id, studentId = cs.StudentId })">
                                        View
                                    </a>

                                    <form method="post"
                                          action="@Url.Action("RemoveStudent", "Professor")"
                                          class="inline-form">
                                        <input type="hidden" name="courseId" value="@Model.Id" />
                                        <input type="hidden" name="studentId" value="@cs.StudentId" />

                                        <button class="btn-danger-soft student-action-btn"
                                                type="submit"
                                                onclick="return confirm('Remove this student from the class?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

    </div>
</div>

<script>
    const studentSearch = document.getElementById("studentSearch");
    const studentRows = document.querySelectorAll(".student-row");

    if (studentSearch) {
        studentSearch.addEventListener("input", function () {
            const value = this.value.trim().toLowerCase();

            studentRows.forEach(row => {
                const email = row.dataset.studentEmail || "";

                if (email.includes(value)) {
                    row.style.display = "grid";
                } else {
                    row.style.display = "none";
                }
            });
        });
    }
</script>