@model List<SmartAttendance.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Edit Attendance";

    int courseId = ViewBag.CourseId;
    int studentId = ViewBag.StudentId;
    string courseName = ViewBag.CourseName ?? "";
    string studentEmail = ViewBag.StudentEmail ?? "";
}

<div class="app-shell">
    <div class="hero-card attendance-edit-card">

        <div class="attendance-edit-header">
            <div>
                <div class="brand">Smart Attendance</div>

                <div class="hero-title" style="font-size:32px; margin-top:16px;">
                    Edit Attendance
                </div>

                <div class="muted">
                    @courseName — @studentEmail
                </div>
            </div>

            <a href="@Url.Action("Course", "Professor", new { id = courseId })"
               class="course-back-link">
                ← Back to Course
            </a>
        </div>

        <div class="attendance-edit-grid">

            <div class="attendance-form-card">
                <h2>Add or Update Attendance</h2>

                <form method="post" action="@Url.Action("SaveAttendance", "Professor")">
                    <input type="hidden" name="courseId" value="@courseId" />
                    <input type="hidden" name="studentId" value="@studentId" />

                    <div class="attendance-form-row">
                        <label class="lbl">Date</label>
                        <input class="form-control"
                               type="date"
                               name="date"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="attendance-form-row">
                        <label class="lbl">Status</label>
                        <select class="form-control" name="status">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Recovered">Recovered</option>
                        </select>
                    </div>

                    <button class="btn-primary-soft" type="submit" style="margin-top:16px;">
                        Save Attendance
                    </button>
                </form>
            </div>

            <div class="attendance-list-card">
                <h2>Attendance History</h2>

                <div class="attendance-records-scroll">
                    @if (!Model.Any())
                    {
                        <div class="muted attendance-empty">
                            No attendance records were found for this student.
                        </div>
                    }
                    else
                    {
                        foreach (var record in Model)
                        {
                            <div class="attendance-record-row">
                                <div>
                                    <div class="attendance-date">
                                        @record.Date.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="attendance-status @record.Status.ToLowerInvariant()">
                                        @record.Status
                                    </div>
                                </div>

                                <form method="post"
                                      action="@Url.Action("DeleteAttendance", "Professor")">
                                    <input type="hidden" name="id" value="@record.Id" />
                                    <input type="hidden" name="courseId" value="@courseId" />
                                    <input type="hidden" name="studentId" value="@studentId" />

                                    <button class="icon-btn danger"
                                            type="submit"
                                            title="Delete Record"
                                            onclick="return confirm('Delete this attendance record?');">
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

    </div>
</div>