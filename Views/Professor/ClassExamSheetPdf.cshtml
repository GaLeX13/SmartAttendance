@model List<SmartAttendance.ViewModels.ClassStudentAttendanceSummaryViewModel>

@{
    Layout = null;

    string courseName = ViewBag.CourseName ?? "";
    string courseType = ViewBag.CourseType ?? "";
    string professorName = ViewBag.ProfessorName ?? "";
    string filterLabel = ViewBag.FilterLabel ?? "";
    DateTime generatedAt = ViewBag.GeneratedAt ?? DateTime.Now;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Exam Attendance Sheet</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            color: #111;
            margin: 28px;
            font-size: 12px;
        }

        .sheet-header {
            border-bottom: 1px solid #111;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        h1 {
            margin: 0 0 8px 0;
            font-size: 20px;
        }

        .meta {
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 14px;
        }

        th,
        td {
            border: 1px solid #111;
            padding: 6px 7px;
            text-align: left;
            vertical-align: middle;
        }

        th {
            font-weight: 700;
        }

        .student-column {
            width: 58%;
        }

        .attendance-column {
            width: 14%;
            text-align: center;
        }

        .signature-column {
            width: 28%;
        }

        .signature-space {
            height: 18px;
        }

        .footer {
            margin-top: 16px;
            font-size: 10px;
        }

        @@media print {
            body {
                margin: 18px;
            }

            tr {
                page-break-inside: avoid;
            }
        }
    </style>
</head>

<body>
    <div class="sheet-header">
        <h1>Exam Attendance Sheet</h1>

        <div class="meta">
            <div><strong>Course:</strong> @courseName</div>
            <div><strong>Type:</strong> @courseType</div>
            <div><strong>Professor:</strong> @professorName</div>
            <div><strong>Filter:</strong> @filterLabel</div>
            <div><strong>Generated at:</strong> @generatedAt.ToString("dd.MM.yyyy HH:mm")</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p>No students match the selected filters.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th class="student-column">Student Email</th>
                    <th class="attendance-column">Attendance</th>
                    <th class="signature-column">Signature</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentEmail</td>
                        <td class="attendance-column">@student.AttendedSessions / @student.CountedSessions</td>
                        <td>
                            <div class="signature-space"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="footer">
        Generated by Smart Attendance.
    </div>

    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>