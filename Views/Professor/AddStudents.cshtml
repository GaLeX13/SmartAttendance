@{
    ViewData["Title"] = "Add Students";
}

<div class="app-shell">
    <div class="hero-card dashboard-card">

        <div class="brand">Smart Attendance</div>

        <div class="hero-title">
            Add Students – @ViewBag.CourseName
        </div>

        <form method="post">
            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />

            <label class="lbl">
                Student Emails
            </label>

            <textarea name="emails"
                      class="form-control"
                      rows="8"
                      placeholder="One email per line:
student1@ucv.ro
student2@ucv.ro"></textarea>

            <div class="add-actions">
                <button type="submit" class="btn-primary-soft">
                    Save
                </button>

                <a href="@Url.Action("Course", "Professor", new { id = ViewBag.CourseId })"
                   class="btn-ghost">
                    Back
                </a>
            </div>
        </form>

    </div>
</div>