@model SmartAttendance.ViewModels.HardwareControlViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Hardware Control";

    string modeClass = Model.CurrentMode.ToLowerInvariant();

    int weekYear = ISOWeek.GetYear(DateTime.Today);
    int weekNumber = ISOWeek.GetWeekOfYear(DateTime.Today);
    string currentWeek = $"{weekYear}-W{weekNumber:00}";
}

<div class="app-shell">
    <div class="hero-card hardware-card">

        <div class="hardware-header">
            <div>
                <div class="brand">Smart Attendance</div>

                <div class="hero-title" style="font-size:34px; margin-top:16px;">
                    Hardware Control
                </div>

                <div class="muted">
                    @Model.CourseName - @Model.CourseType
                </div>
            </div>

            <a href="@Url.Action("Course", "Professor", new { id = Model.CourseId })"
               class="course-back-link">
                Back to course
            </a>
        </div>

        @if (TempData["HardwareMessage"] != null)
        {
            <div class="settings-message">
                @TempData["HardwareMessage"]
            </div>
        }

        <div class="hardware-grid">

            <div class="hardware-panel">
                <h2>Device Status</h2>

                <div class="hardware-status-card">
                    <div class="hardware-label">Device Key</div>
                    <div class="hardware-value">@Model.DeviceKey</div>
                </div>

                <div class="hardware-status-card">
                    <div class="hardware-label">Current Mode</div>
                    <div class="hardware-mode-pill @modeClass">
                        @Model.CurrentMode
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SessionCourseName))
                {
                    <div class="hardware-status-card">
                        <div class="hardware-label">Active Course</div>
                        <div class="hardware-value">@Model.SessionCourseName</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CurrentStudentEmail))
                {
                    <div class="hardware-status-card">
                        <div class="hardware-label">Current Assignment Student</div>
                        <div class="hardware-value">@Model.CurrentStudentEmail</div>
                    </div>
                }

                <div class="hardware-status-card">
                    <div class="hardware-label">Students Without RFID Tag</div>
                    <div class="hardware-value">@Model.StudentsWithoutTag</div>
                </div>
            </div>

            <div class="hardware-panel">
                <h2>Device Actions</h2>

                @if (Model.DeviceIsBusy)
                {
                    <div class="hardware-warning">
                        The device is currently active for another course. Stop it there before starting a new session.
                    </div>
                }

                <div class="hardware-actions">
                    <form method="post" action="@Url.Action("StartAssignment", "Hardware")">
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <button class="btn-primary-soft hardware-action-btn"
                                type="submit"
                                @(Model.DeviceIsBusy ? "disabled" : null)>
                            Start Assignment
                        </button>
                    </form>

                    <form method="post" action="@Url.Action("StartAttendance", "Hardware")">
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <button class="btn-primary-soft hardware-action-btn"
                                type="submit"
                                @(Model.DeviceIsBusy ? "disabled" : null)>
                            Start Attendance
                        </button>
                    </form>

                    <form method="post" action="@Url.Action("StopDevice", "Hardware")">
                        <input type="hidden" name="courseId" value="@Model.CourseId" />

                        <button class="btn-primary-soft hardware-action-btn stop"
                                type="submit">
                            Stop Device
                        </button>
                    </form>

                    <div class="hardware-week-action">
                        <div>
                            <div class="hardware-week-title">Complete weekly absences</div>

                            <div class="hardware-week-text">
                                Use this after an attendance session has ended.
                                Students without an attendance record for the selected week will be marked as absent.
                            </div>
                        </div>

                        <form method="post"
                              action="@Url.Action("CompleteMissingAttendance", "Professor")"
                              class="hardware-week-form">

                            <input type="hidden" name="id" value="@Model.CourseId" />

                            <input class="hardware-week-input"
                                   type="week"
                                   name="selectedWeek"
                                   value="@currentWeek" />

                            <button class="btn-danger-soft hardware-week-btn" type="submit">
                                Mark absences
                            </button>
                        </form>
                    </div>
                </div>

                <p class="page-help-text hardware-description">
                    Use assignment mode when registering RFID tags for students.
                    Use attendance mode during class, after the students have received their tags.
                    The board will read each tag and send the scan to the application.
                </p>
            </div>

        </div>

    </div>
    @if (Model.CurrentMode == "Assign")
    {
        <script>
            setTimeout(() => {
                window.location.reload();
            }, 3000);
        </script>
    }
</div>