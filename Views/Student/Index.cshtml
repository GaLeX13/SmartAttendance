@model List<SmartAttendance.ViewModels.StudentCourseSummaryViewModel>

@{
    ViewData["Title"] = "Student Dashboard";
    string email = ViewBag.Email ?? "student";
}

<div class="app-shell">
    <div class="hero-card student-dashboard-card">

        <div class="student-dashboard-header">
            <div>
                <div class="brand">Smart Attendance</div>

                <div class="hero-title" style="font-size:34px; margin-top:18px;">
                    Student Dashboard
                </div>

                <div class="muted">
                    Logged in as @email
                </div>
            </div>

            <a href="@Url.Action("Logout", "StudentAuth")"
               class="course-back-link">
                Logout
            </a>
        </div>

        <div class="student-dashboard-body single-column">
            <div class="student-courses-card wide">
                <div class="students-header">
                    <h2>My Courses</h2>
                </div>

                <div class="student-courses-list wide">
                    @if (!Model.Any())
                    {
                        <div class="muted attendance-empty">
                            You are not enrolled in any courses yet.
                        </div>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <a class="student-course-row detailed"
                               href="@Url.Action("CourseDetails", "Student", new { id = item.Course.Id })">

                                <div>
                                    <div class="student-course-title">@item.Course.Name</div>
                                    <div class="student-course-type">
                                        @(item.Course.IsLab ? "Laboratory" : "Course")
                                    </div>
                                </div>

                                <div class="student-course-attendance">
                                    <div class="student-course-percent">
                                        @item.AttendancePercent%
                                    </div>

                                    <div class="student-course-sessions">
                                        @item.AttendedSessions / @item.CountedSessions sessions
                                    </div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>