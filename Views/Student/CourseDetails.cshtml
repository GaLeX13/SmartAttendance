@model List<SmartAttendance.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Course Attendance";

    int courseId = (int)ViewBag.CourseId;

    string courseName = ViewBag.CourseName ?? "";
    string courseType = ViewBag.CourseType ?? "";
    string studentEmail = ViewBag.StudentEmail ?? "";

    int presentCount = ViewBag.PresentCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
    int recoveredCount = ViewBag.RecoveredCount ?? 0;
    int countedSessions = ViewBag.CountedSessions ?? 0;
    int effectiveAbsences = ViewBag.EffectiveAbsences ?? 0;
    int attendancePercent = ViewBag.AttendancePercent ?? 0;

    int minimumAttendanceRequired = ViewBag.MinimumAttendanceRequired ?? 0;
    string professorContactEmail = ViewBag.ProfessorContactEmail ?? "";
    bool autoFillAbsencesEnabled = ViewBag.AutoFillAbsencesEnabled ?? false;
    int autoFillDayOfWeek = ViewBag.AutoFillDayOfWeek ?? 0;
    TimeSpan autoFillTime = ViewBag.AutoFillTime ?? new TimeSpan(12, 0, 0);
    string eligibilityStatus = ViewBag.EligibilityStatus ?? "Not evaluated yet";

    var dayNames = new[]
    {
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
    };

    string autoFillDayName = dayNames[Math.Clamp(autoFillDayOfWeek, 0, 6)];

    string eligibilityClass = eligibilityStatus == "Eligible"
        ? "eligible"
        : eligibilityStatus == "Not eligible"
            ? "not-eligible"
            : "pending";

    var barLabels = ViewBag.BarChartLabels as List<string> ?? new List<string>();
    var barValues = ViewBag.BarChartValues as List<int> ?? new List<int>();
    var barStatuses = ViewBag.BarChartStatuses as List<string> ?? new List<string>();

    var lineLabels = ViewBag.LineChartLabels as List<string> ?? new List<string>();
    var lineValues = ViewBag.LineChartValues as List<int> ?? new List<int>();

    var linePoints = new List<string>();

    for (int i = 0; i < lineValues.Count; i++)
    {
        int x = lineValues.Count == 1
            ? 160
            : 20 + (i * 280 / (lineValues.Count - 1));

        int y = 120 - lineValues[i];

        linePoints.Add($"{x},{y}");
    }

    string linePointsText = string.Join(" ", linePoints);
}

<div class="app-shell">
    <div class="hero-card course-details-card">

        <div class="course-details-header">
            <div>
                <div class="brand">Smart Attendance</div>

                <div class="hero-title" style="font-size:32px; margin-top:16px;">
                    Course Attendance
                </div>

                <div class="muted">
                    @courseName — @courseType
                </div>

                <div class="muted" style="margin-top:4px;">
                    @studentEmail
                </div>
            </div>

            <a href="@Url.Action("Index", "Student")"
               class="course-back-link">
                Back to dashboard
            </a>
        </div>

        <div class="course-details-grid">

            <div class="course-details-left">
                <h2>Overview</h2>

                <div class="stat-box-grid">
                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Attendance</div>
                        <div class="stat-mini-value">@attendancePercent%</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Present</div>
                        <div class="stat-mini-value">@presentCount</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Absences</div>
                        <div class="stat-mini-value">@absentCount</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Recoveries</div>
                        <div class="stat-mini-value">@recoveredCount</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Counted Sessions</div>
                        <div class="stat-mini-value">@countedSessions</div>
                    </div>

                    <div class="stat-mini-card">
                        <div class="stat-mini-label">Effective Absences</div>
                        <div class="stat-mini-value">@effectiveAbsences</div>
                    </div>
                </div>

                <div class="course-rules-card">
                    <div class="course-rules-header">
                        <div class="chart-title">Course Rules</div>

                        <span class="eligibility-pill @eligibilityClass">
                            @eligibilityStatus
                        </span>
                    </div>

                    <div class="course-rules-grid">
                        <div>
                            <div class="rule-label">Minimum required</div>
                            <div class="rule-value">@minimumAttendanceRequired%</div>
                        </div>

                        <div>
                            <div class="rule-label">Current attendance</div>
                            <div class="rule-value">@attendancePercent%</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(professorContactEmail))
                    {
                        <div class="rule-contact">
                            <span>Professor contact:</span>
                            <a href="mailto:@professorContactEmail">@professorContactEmail</a>
                        </div>
                    }

                    @if (autoFillAbsencesEnabled)
                    {
                        <div class="rule-note">
                            Automatic absence completion is scheduled for @autoFillDayName at @autoFillTime.ToString("hh\\:mm").
                            If attendance is recorded during a week, students without a mark may be automatically marked as absent.
                            Recovered records do not start this process.
                        </div>
                    }
                    else
                    {
                        <div class="rule-note">
                            Automatic absence completion is currently disabled for this course.
                        </div>
                    }
                </div>

                <div class="student-chart-card">
                    <div class="chart-card-header">
                        <div class="chart-title">Attendance Timeline</div>

                        <div class="chart-actions">
                            <button class="chart-toggle active" type="button" data-chart="bars">
                                Bars
                            </button>

                            <button class="chart-toggle" type="button" data-chart="line">
                                Line
                            </button>

                            <a class="chart-export"
                               href="@Url.Action("CourseDetailsPdf", "Student", new { id = courseId })"
                               target="_blank">
                                Export PDF
                            </a>
                        </div>
                    </div>

                    @if (!barLabels.Any())
                    {
                        <div class="chart-empty">
                            No attendance records yet.
                        </div>
                    }
                    else
                    {
                        <div id="barsChart" class="chart-panel">
                            <div class="student-attendance-chart">
                                @for (int i = 0; i < barLabels.Count; i++)
                                {
                                    var value = barValues[i];
                                    var status = barStatuses[i].ToLower();
                                    var barHeight = Math.Max(value, 8);

                                    <div class="student-chart-column">
                                        <div class="student-chart-bar-wrap">
                                            <div class="student-chart-bar @status"
                                                 style="height:@barHeight%;"></div>
                                        </div>

                                        <div class="chart-label">@barLabels[i]</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div id="lineChart" class="chart-panel hidden-chart">
                            <div class="line-chart-box">
                                <svg viewBox="0 0 320 140" class="line-chart-svg">
                                    <line x1="20" y1="120" x2="300" y2="120" class="line-axis" />
                                    <line x1="20" y1="20" x2="20" y2="120" class="line-axis" />

                                    <polyline points="@linePointsText" class="line-chart-path" />

                                    @for (int i = 0; i < lineValues.Count; i++)
                                    {
                                        int x = lineValues.Count == 1
                                        ? 160
                                        : 20 + (i * 280 / (lineValues.Count - 1));

                                        int y = 120 - lineValues[i];

                                        <circle cx="@x" cy="@y" r="4" class="line-chart-dot" />
                                    }
                                </svg>

                                <div class="line-chart-labels">
                                    @foreach (var label in lineLabels)
                                    {
                                        <span>@label</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="course-details-right">
                <div class="attendance-list-header">
                    <h2>Records</h2>
                </div>

                <div class="course-details-records-scroll">
                    @if (!Model.Any())
                    {
                        <div class="muted attendance-empty">
                            No attendance records found for this course.
                        </div>
                    }
                    else
                    {
                        foreach (var record in Model)
                        {
                            <div class="attendance-record-row">
                                <div>
                                    <div class="attendance-date">
                                        @record.Date.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="attendance-status @record.Status.ToLower()">
                                        @if (record.Status == "Present")
                                        {
                                            <span>Present</span>
                                        }
                                        else if (record.Status == "Recovered")
                                        {
                                            <span>Recovered</span>
                                        }
                                        else
                                        {
                                            <span>Absent</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

    </div>
</div>

<script>
    const chartButtons = document.querySelectorAll(".chart-toggle");
    const barsChart = document.getElementById("barsChart");
    const lineChart = document.getElementById("lineChart");

    chartButtons.forEach(button => {
        button.addEventListener("click", () => {
            if (!barsChart || !lineChart) {
                return;
            }

            chartButtons.forEach(btn => btn.classList.remove("active"));
            button.classList.add("active");

            const selectedChart = button.dataset.chart;

            if (selectedChart === "bars") {
                barsChart.classList.remove("hidden-chart");
                lineChart.classList.add("hidden-chart");
            }

            if (selectedChart === "line") {
                lineChart.classList.remove("hidden-chart");
                barsChart.classList.add("hidden-chart");
            }
        });
    });
</script>