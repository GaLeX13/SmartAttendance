@{
    ViewData["Title"] = "Home";
}

<div class="app-shell">
    <div class="hero-card">

        <div class="brand">Smart Attendance</div>

        <div id="introBlock" class="fade-lite">
            <div class="hero-title">
                Welcome to Smart Attendance
            </div>

            <div class="hero-subtitle">
                A student attendance platform designed for fast course management,
                attendance tracking, RFID-based identification, and academic reporting.
            </div>

            <button id="btnStart" class="btn-primary-soft">
                Start
            </button>
        </div>

        <div id="choiceBlock" class="fade-lite hidden">
            <div class="choice-grid">

                <div class="choice-left">
                    <div class="feature-list">
                        <div>✔ RFID-based attendance identification</div>
                        <div>✔ Course and laboratory attendance management</div>
                        <div>✔ Student attendance statistics and reports</div>
                        <div>✔ Hardware integration with ESP32 and RFID modules</div>
                    </div>

                    <div class="choice-header">
                        Choose your account type
                    </div>

                    <div class="choice-buttons">
                        <a class="btn-primary-soft" href="@Url.Action("Login", "StudentAuth")">
                            Student Login
                        </a>

                        <a class="btn-primary-soft" href="@Url.Action("Login", "ProfessorAuth")">
                            Professor Login
                        </a>
                    </div>
                </div>

                <div class="choice-right">
                    <div class="hw-title">
                        Hardware Prototype
                    </div>

                    <div class="hw-slider">
                        <img class="hw-slide active" src="~/img/hardware/hw1.jpg" alt="Hardware prototype view 1" />
                        <img class="hw-slide" src="~/img/hardware/hw2.jpg" alt="Hardware prototype view 2" />
                        <img class="hw-slide" src="~/img/hardware/hw3.jpg" alt="Hardware prototype view 3" />
                    </div>

                    <div class="hw-caption" id="hwCaption">
                        ESP32 prototype with RFID attendance support
                    </div>
                </div>

            </div>
        </div>

        <div class="footer-note">
            Bachelor's thesis project by Gheorghe D. Alexandru, S1b - CEN.<br />
            Coordinated by Dr. Ing. Eugen Dumitrascu, Lecturer, University of Craiova.
        </div>

    </div>
</div>

<script>
    const intro = document.getElementById("introBlock");
    const choice = document.getElementById("choiceBlock");
    const start = document.getElementById("btnStart");

    start.addEventListener("click", () => {
        intro.classList.add("hidden");

        setTimeout(() => {
            choice.classList.remove("hidden");
        }, 180);
    });
</script>

<script>
    const slides = Array.from(document.querySelectorAll(".hw-slide"));
    const captions = [
        "ESP32 prototype with RFID attendance support",
        "RFID reader used for fast student identification",
        "Hardware setup prepared for attendance validation"
    ];

    const captionEl = document.getElementById("hwCaption");
    let currentSlide = 0;

    function showSlide(index) {
        slides.forEach(slide => slide.classList.remove("active"));
        slides[index].classList.add("active");

        if (captionEl) {
            captionEl.textContent = captions[index] ?? "";
        }
    }

    showSlide(0);

    setInterval(() => {
        currentSlide = (currentSlide + 1) % slides.length;
        showSlide(currentSlide);
    }, 3500);
</script>