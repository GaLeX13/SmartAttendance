@{
    ViewData["Title"] = "Professor Registration";
}

<div class="app-shell">
    <div class="hero-card" style="padding: 34px 42px;">

        <div class="brand">Study Sync</div>

        <div class="hero-title" style="font-size: 34px; margin-top: 18px;">
            Create <span style="color:#2f7dbf;">Professor Account</span>
        </div>

        <form method="post" style="max-width:520px; margin-top:18px;">
            <div style="display:grid; gap:12px;">

                <label>Email Address</label>
                <input name="email" class="form-control" />

                <label>Password</label>
                <input name="password" type="password" class="form-control" />

                <label>Confirm Password</label>
                <input name="confirmPassword" type="password" class="form-control" />

                <label>Access Key</label>
                <input name="accessKey" class="form-control" placeholder="Required for registration" />

                @if (ViewBag.Error != null)
                {
                    <div style="color:#b00020; font-weight:600;">@ViewBag.Error</div>
                }

                <button class="btn-primary-soft" style="width:220px;">
                    Create Account
                </button>

                <a href="@Url.Action("Login", "ProfessorAuth")"
                   style="font-weight:700; color:#2f7dbf; text-decoration:none;">
                    Already have an account? Login
                </a>
            </div>
        </form>

        <div class="footer-note">
            Bachelor's thesis project by Gheorghe D. Alexandru, S1b - CEN.<br />
            Coordinated by Dr. Ing. Eugen Dumitrașcu, Lecturer, University of Craiova.
        </div>

    </div>
</div>