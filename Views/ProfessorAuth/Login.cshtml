@{
    ViewData["Title"] = "Professor Login";
}

<div class="app-shell">
    <div class="hero-card" style="padding: 34px 42px;">

        <div class="brand">Smart Attendance</div>

        <div class="hero-title" style="font-size: 34px; margin-top: 18px;">
            Professor <span style="color:#2f7dbf;">Login</span>
        </div>

        <form method="post" style="max-width:520px; margin-top:18px;">
            <div style="display:grid; gap:12px;">
                <div style="display:grid; gap:6px;">
                    <label style="color:var(--muted); font-weight:600;">Email Address</label>
                    <input name="email" class="form-control" placeholder="professor@example.com" />
                </div>

                <div style="display:grid; gap:6px;">
                    <label style="color:var(--muted); font-weight:600;">Password</label>
                    <input name="password" type="password" class="form-control" placeholder="password" />
                </div>

                @if (ViewBag.Error != null)
                {
                    <div style="color:#b00020; font-weight:600;">@ViewBag.Error</div>
                }

                <button class="btn-primary-soft" type="submit" style="width: 220px; margin-top: 6px;">
                    Login
                </button>

                <a href="@Url.Action("Register", "ProfessorAuth")"
                   style="display:inline-block; margin-top:6px; font-weight:700; color:#2f7dbf; text-decoration:none;">
                    Create New Account
                </a>
            </div>
        </form>

        <div class="footer-note">
            Bachelor's thesis project by Gheorghe D. Alexandru, S1b - CEN.<br />
            Coordinated by Dr. Ing. Eugen Dumitrascu, Lecturer, University of Craiova.
        </div>
    </div>
</div>